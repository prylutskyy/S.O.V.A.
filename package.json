{
  "name": "sova-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:corpus": "vitest run tests/evaluation/corpus.evaluation.test.ts",
    "test:dashboard": "node scripts/evaluation/generate-dashboard.mjs",
    "test:groq": "vitest run tests/integration/groq.integration.test.ts",
    "test:watch": "vitest",
    "classifier:prepare": "node scripts/local-classifier/run.mjs prepare",
    "classifier:train": "node scripts/local-classifier/run.mjs train",
    "classifier:evaluate": "node scripts/local-classifier/run.mjs evaluate",
    "classifier:compare": "node scripts/local-classifier/run.mjs compare",
    "classifier:pilot": "node scripts/local-classifier/run.mjs pilot",
    "classifier:relations": "node scripts/local-classifier/run.mjs relations"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@types/chrome": "^0.0.280",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1",
    "wxt": "^0.19.16"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
